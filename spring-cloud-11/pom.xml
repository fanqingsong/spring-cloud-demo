	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>com.roncoo.education</groupId>
				<artifactId>spring-cloud-11-api</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.roncoo.education</groupId>
				<artifactId>spring-cloud-11-bean</artifactId>
