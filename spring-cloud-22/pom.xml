<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2201/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>com.roncoo.education</groupId>
		<artifactId>spring-cloud-demo</artifactId>
		<version>0.0.1-SNAPSHOT</version>
		<relativePath>../pom.xml</relativePath>
	</parent>

	<groupId>com.roncoo.education</groupId>
	<artifactId>spring-cloud-22</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>

	<name>spring-cloud-22</name>
	<description>roncoo-spring-cloud project for Spring Boot</description>

	<modules>
		<module>spring-cloud-bean-22</module>
		<module>spring-cloud-api-22</module>
		<module>spring-cloud-consumer-22</module>
		<module>spring-cloud-provider-22</module>
		<module>spring-cloud-service-22</module>
		<module>spring-cloud-turbine-22</module>
		<module>spring-cloud-gateway-22</module>
	</modules>
	


	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<java.version>21</java.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>com.roncoo.education</groupId>
				<artifactId>spring-cloud-bean-22</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.roncoo.education</groupId>
				<artifactId>spring-cloud-api-22</artifactId>
				<version>${project.version}</version>
			</dependency>
			
			<!-- spring cloud -->
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-dependencies</artifactId>
				<version>2024.0.3</version>
				<!-- <version>2024.0.3</version> -->
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

</project>
